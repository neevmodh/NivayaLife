APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Family invitations and medication/vaccination reminders need a real
# mailer to actually reach anyone — "log" just writes emails to the log
# file. Uses Resend (resend.com, free tier: 3,000/month) by default; swap
# MAIL_MAILER for "smtp"/"postmark"/"ses" and its matching config in
# config/mail.php if you'd rather use something else.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI features (report summaries, translations, assistant chat) fall back
# through these in order — GEMINI_API_KEY_2/_3 and GROQ_API_KEY are all
# optional backups; only GEMINI_API_KEY is required for AI features to work.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional standalone chest X-ray classifier (see xray-vision-service/) that
# enriches xray-type reports with real CNN model output alongside the Gemini
# vision description. Leave blank to skip it entirely — everything else
# keeps working unchanged.
XRAY_VISION_URL=
XRAY_VISION_TOKEN=

# Optional standalone PaddleOCR + scispaCy/medspaCy service (see
# clinical-nlp-service/) — a second-opinion OCR engine tried after
# Tesseract, plus biomedical entity (drug/diagnosis) detection on report
# text. Leave blank to skip it entirely — everything else keeps working
# unchanged.
CLINICAL_NLP_URL=
CLINICAL_NLP_TOKEN=

# Grants the read-only admin reporting dashboard (/admin) to this account.
# Not applied automatically — after setting it, run `php artisan admin:sync`
# once (a no-op every time after that account already has the flag).
ADMIN_EMAIL=

# Web push keys for medication/vaccination reminders sent to the installed
# PWA. Generate a pair with:
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# Leave blank to skip push entirely — email reminders keep working unchanged.
VAPID_SUBJECT="mailto:support@novix.app"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Deploy approval gate: admin approves a pushed commit in /admin/deployments,
# which calls Railway's API to deploy it (see App\Services\Railway\RailwayClient).
# Requires disabling Autodeploy for this service+branch in the Railway
# dashboard first (Settings → Source) — that toggle has no public API.
# RAILWAY_API_TOKEN is a secret; generate one in the Railway dashboard.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=f2f7995f-1d86-4f08-9db8-b219c7019b8c
RAILWAY_SERVICE_ID=bdecfe9f-8674-47bc-8738-4c6ef72ecb6e
RAILWAY_ENVIRONMENT_ID=e23cdfe6-3200-4602-89c8-0ccf244c2360

# Shared secret configured on the GitHub repo's webhook (Settings → Webhooks)
# so incoming push events at /webhooks/github can be verified. Generate with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

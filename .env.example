APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Family invitations and medication/vaccination reminders need a real
# mailer to actually reach anyone — "log" just writes emails to the log
# file. Uses Resend (resend.com, free tier: 3,000/month) by default; swap
# MAIL_MAILER for "smtp"/"postmark"/"ses" and its matching config in
# config/mail.php if you'd rather use something else.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set both to "s3" in production to back report storage with Cloudflare R2
# instead of the container's local disk. Leave unset for local dev.
FILESYSTEM_LOCAL_DRIVER=local
FILESYSTEM_PUBLIC_DRIVER=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"

# AI features (report summaries, translations, assistant chat) fall back
# through these in order — GEMINI_API_KEY_2/_3 and GROQ_API_KEY are all
# optional backups; only GEMINI_API_KEY is required for AI features to work.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional self-hosted Ollama instance (see ollama-service/) powering a
# retrieval-augmented pipeline for the Assistant chat specifically. Unset
# means the assistant falls straight back to the Gemini/Groq full-context
# prompt it already used — this is purely additive.
OLLAMA_URL=
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Set this in containers to the CPU quota (Railway Hobby = 8). Leaving it unset
# on a normal machine is correct; setting it wrong is a ~26x slowdown.
OLLAMA_NUM_THREAD=

# Optional standalone chest X-ray classifier (see xray-vision-service/) that
# enriches xray-type reports with real CNN model output alongside the Gemini
# vision description. Leave blank to skip it entirely — everything else
# keeps working unchanged.
XRAY_VISION_URL=
XRAY_VISION_TOKEN=

# Optional standalone PaddleOCR + scispaCy/medspaCy service (see
# clinical-nlp-service/) — a second-opinion OCR engine tried after
# Tesseract, plus biomedical entity (drug/diagnosis) detection on report
# text. Leave blank to skip it entirely — everything else keeps working
# unchanged.
CLINICAL_NLP_URL=
CLINICAL_NLP_TOKEN=

# Grants the read-only admin reporting dashboard (/admin) to this account.
# Not applied automatically — after setting it, run `php artisan admin:sync`
# once (a no-op every time after that account already has the flag).
ADMIN_EMAIL=

# Web push keys for medication/vaccination reminders sent to the installed
# PWA. Generate a pair with:
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# Leave blank to skip push entirely — email reminders keep working unchanged.
VAPID_SUBJECT="mailto:support@nivayalife.app"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
